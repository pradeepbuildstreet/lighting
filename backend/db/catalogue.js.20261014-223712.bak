"use strict";
const {Pool}=require('pg');
let pool;
function getPool(){
 if(pool)return pool;
 const raw=process.env.CATALOG_DATABASE_URL;
 if(!raw){const e=new Error('Catalogue database is not configured');e.status=503;throw e;}
 const url=new URL(raw);const legacy=new URL(process.env.DATABASE_URL);
 if(!['postgres:','postgresql:'].includes(url.protocol))throw new Error('Invalid catalogue database protocol');
 if(url.pathname===legacy.pathname){const e=new Error('Catalogue database name must differ from legacy database');e.status=503;throw e;}
 pool=new Pool({connectionString:raw,max:5,connectionTimeoutMillis:5000,idleTimeoutMillis:30000});
 pool.on('error',e=>console.error(JSON.stringify({event:'catalogue_pool_error',code:e.code})));
 return pool;
}
async function query(sql,args){return getPool().query(sql,args);}
async function transaction(work){
 const client=await getPool().connect();
 try{await client.query('BEGIN');const value=await work(client);await client.query('COMMIT');return value;}
 catch(e){try{await client.query('ROLLBACK');}catch(_){}throw e;}finally{client.release();}
}
async function actor(client,user){
 // No password or token is copied. Authentication remains on the existing database.
 await client.query(`INSERT INTO app_users(id,email,password_hash,role,is_active) VALUES($1,$2,'EXTERNAL_AUTH_ONLY','admin',true)
 ON CONFLICT(id) DO UPDATE SET email=EXCLUDED.email,role='admin',is_active=true`,[user.id,user.email]);
}
async function close(){if(pool){await pool.end();pool=undefined;}}
module.exports={query,transaction,actor,close};
