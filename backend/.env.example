# COPY VALUES into backend/.env in your LOCAL working copy. Do not overwrite real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
SITE_URL=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3001
# Stage A MUST use the existing legacy-schema local database.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/EXISTING_LOCAL_DATABASE
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TRUST_PROXY=false
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
MEDIA_STORAGE_ROOT=D:/luminoza-media
# Retain current upload URL while legacy upload route remains in use:
IMAGE_REPO_URL=http://localhost:3001/uploads
# AUTH_COOKIE_DOMAIN is normally omitted for same-origin local testing.
